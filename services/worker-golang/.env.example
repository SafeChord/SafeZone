# Environment variables read by worker-golang (app/config/config.go).
# Values are placeholders, never real credentials; the deployment supplies its own.
# A variable left unset takes the default in code, which matches the value shown here.
# An unparsable number, duration or log level falls back to that default with a warning on stderr.
ENVIRONMENT=TEST # staging or prod (lowercase) logs JSON in zap production format; any other value logs in zap development format
LOG_LEVEL=info # Lowest level logged: debug, info, warn or error, in either case

# Service settings
SERVICE_NAME=worker-golang # Reported as the service field of every log line
SERVICE_VERSION=0.1.0 # Reported as the service_version field of every log line

# batch processing settings
BATCH_SIZE=5 # Maximum events read per poll and persisted in one write (integer; 0 or less means 100)
FLUSH_INTERVAL=1s # Longest wait for a batch to fill before persisting what has arrived (Go duration, e.g. 500ms, 1s)
LIVENESS_WINDOW=30s # Maximum time since a consume-loop turn before /health returns 503 (Go duration; keep above FLUSH_INTERVAL)
DEPENDENCY_TIMEOUT=10s # Maximum time for a database write or Kafka offset commit (Go duration; keep below LIVENESS_WINDOW)

# health endpoint settings
SERVER_IP=0.0.0.0 # Interface address for the HTTP health endpoint
SERVER_PORT=8080 # Port for the HTTP health endpoint (integer)

# parallel processing settings
WORKER_COUNT=1 # Number of consumers this process runs in the group (integer)
PARALLEL_N=1 # Maximum consumers running at a time (integer; 0 or less means all of WORKER_COUNT)

# kafka settings
KAFKA_BROKER=localhost:9092 # Seed brokers, comma-separated host:port
KAFKA_GROUP_ID=worker-group # Consumer group
KAFKA_TOPIC=covid-events # Case event topic

# database settings
DB_URL=postgres://postgres:password@localhost:5432/safezone # PostgreSQL connection URL (placeholder credentials)
