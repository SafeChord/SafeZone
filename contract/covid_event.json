{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "covid_event",
  "description": "Event on the covid case topic, published by data-ingestor and consumed by worker-golang. Adding a field is a contract change and takes a new version.",
  "type": "object",
  "required": ["event_type", "event_time", "trace_id", "payload", "version"],
  "additionalProperties": false,
  "properties": {
    "event_type": {"const": "covid_event"},
    "event_time": {"type": "integer", "minimum": 0, "description": "Milliseconds since the epoch."},
    "trace_id": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["date", "city", "region", "cases"],
      "additionalProperties": false,
      "properties": {
        "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "city": {"type": "string", "minLength": 1, "maxLength": 50},
        "region": {"type": "string", "minLength": 1, "maxLength": 50},
        "cases": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "version": {"const": "0.1.0"}
  }
}
